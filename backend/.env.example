# ---- copy to backend/.env and fill in. NEVER commit .env ----
ENV=development
DEBUG=true

# MongoDB. Rotate any credential that was ever committed to git.
# Copy the FULL connection string from Atlas (Connect -> Drivers). The host
# is cluster-specific, e.g. cluster01.ab1cd.mongodb.net — "cluster.mongodb.net"
# below is a placeholder and will fail DNS lookup.
MONGO_URI=mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=YourApp
MONGO_DB=health_app

# mongodb+srv:// needs SRV records, which many home/office resolvers don't
# return. Leave blank to use your system resolver.
DNS_NAMESERVERS=8.8.8.8,1.1.1.1

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

# Only matters when the web app is served from a different origin than the
# API (npm start on :3000). The single-container deploy is same-origin.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Any OpenAI-compatible endpoint.
#   Ollama local : http://127.0.0.1:11434/v1        LLM_MODEL=llama3:8b
#   Groq         : https://api.groq.com/openai/v1   LLM_MODEL=llama-3.3-70b-versatile
#   OpenAI       : https://api.openai.com/v1        LLM_MODEL=gpt-4o-mini
# A deployed instance cannot reach an Ollama on your laptop: production
# refuses to start if this still points at localhost.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=llama3:8b
LLM_API_KEY=
LLM_TIMEOUT=60
# Used when LLM_MODEL is rate limited (hosted free tiers meter per model).
#   Groq: llama-3.1-8b-instant
LLM_FALLBACK_MODEL=

# Sentiment. auto = ONNX if models/model.onnx exists, else torch.
#   python scripts/fetch_sentiment_model.py   downloads the 68 MB ONNX model
#   pip install -r requirements-torch.txt     only if you want the torch backend
SENTIMENT_BACKEND=auto
SENTIMENT_MODEL_PATH=./models
SENTIMENT_NEUTRAL_THRESHOLD=0.80

# Hindi/Marathi <-> English. auto = Google first, the LLM if that fails.
#   auto | google | llm | off
TRANSLATION_PROVIDER=auto

CHAT_WINDOW_TURNS=12
SUMMARISE_AFTER_TURNS=20

# Verification emails. The first one that is configured wins:
#   BREVO_API_KEY   + EMAIL_FROM   HTTPS API  (works on hosts that block SMTP)
#   RESEND_API_KEY  + EMAIL_FROM   HTTPS API
#   EMAIL_PASSWORD  + EMAIL_FROM   SMTP (Gmail app password) — local use
# With none set, development logs the code to the console and production
# returns an error instead of pretending to send.
EMAIL_FROM=
EMAIL_FROM_NAME=MindWell
BREVO_API_KEY=
RESEND_API_KEY=
EMAIL_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
OTP_TTL_SECONDS=300

# POST /signup skips email verification. On in development, off in
# production unless you set this to true.
# ALLOW_DIRECT_SIGNUP=true

RATE_LIMIT_CHAT=30
RATE_LIMIT_AUTH=10
RATE_LIMIT_WINDOW=60

CRISIS_REGION=IN

# Minutes ahead of UTC used to decide what "today" is. 330 = IST.
TZ_OFFSET_MINUTES=330
