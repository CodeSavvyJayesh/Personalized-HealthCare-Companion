# ---- copy to backend/.env and fill in. NEVER commit .env ----
ENV=development
DEBUG=true

# MongoDB. Rotate any credential that was ever committed to git.
# Copy the FULL connection string from Atlas (Connect -> Drivers). The host
# is cluster-specific, e.g. cluster01.ab1cd.mongodb.net — "cluster.mongodb.net"
# below is a placeholder and will fail DNS lookup.
MONGO_URI=mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=YourApp
MONGO_DB=health_app

# mongodb+srv:// needs SRV records, which many home/office resolvers don't
# return. Leave blank to use your system resolver.
DNS_NAMESERVERS=8.8.8.8,1.1.1.1

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Any OpenAI-compatible endpoint.
#   Ollama local : http://127.0.0.1:11434/v1        LLM_MODEL=llama3:8b
#   Groq         : https://api.groq.com/openai/v1   LLM_MODEL=llama-3.3-70b-versatile
#   OpenAI       : https://api.openai.com/v1        LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=llama3:8b
LLM_API_KEY=
LLM_TIMEOUT=60

SENTIMENT_MODEL_PATH=./models
SENTIMENT_NEUTRAL_THRESHOLD=0.80

CHAT_WINDOW_TURNS=12
SUMMARISE_AFTER_TURNS=20

EMAIL_FROM=
EMAIL_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
OTP_TTL_SECONDS=300

RATE_LIMIT_CHAT=30
RATE_LIMIT_AUTH=10
RATE_LIMIT_WINDOW=60

CRISIS_REGION=IN
